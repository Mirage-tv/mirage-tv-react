{
  "name": "mirage",
  "type": "javascript",
  "main": "dist/_worker.js",
  "compatibility_date": "2025-01-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "env": {
    "production": {
      "name": "mirage-front-prod",
      "routes": [
        {
          "pattern": "example.com/*",
          "zone_name": "example.com",
        },
      ],
    },
  },
}
